{
  "manifest_version": 3,
  "name": "Footprint: privacy scans",
  "short_name": "Footprint",
  "version": "0.3.0",
  "description": "Scan your social media privacy settings, fix what you approve, untag yourself and clear old posts. Your data stays in your browser.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Footprint",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://web.facebook.com/*",
    "https://accountscenter.facebook.com/*",
    "https://accountscenter.meta.com/*",
    "https://www.instagram.com/*",
    "https://accountscenter.instagram.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://footprint.example/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}